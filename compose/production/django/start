#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

export DJANGO_SETTINGS_MODULE="config.settings.production"

# collectstatic is already run during Docker build (see Dockerfile line 208)
# Running it here causes permission issues, so we skip it

exec /usr/local/bin/gunicorn config.asgi --bind 0.0.0.0:5000 --chdir=/app -k uvicorn_worker.UvicornWorker
